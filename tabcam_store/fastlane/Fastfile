# fastlane for the store listings and builds, run through
# scripts/store-upload-ios.sh and scripts/store-upload-android.sh (which say
# what they need). Authenticates from the environment, never from the repo:
#   App Store: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (the AuthKey_<ID>.p8 file)
#   Google Play: PLAY_JSON_KEY_PATH (a service account's JSON key)
# Paths are relative to tabcam_store/, where fastlane runs.
default_platform(:ios)

APP_ID = "com.nu01.tabcam"

def asc_api_key
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |name|
    UI.user_error!("#{name} isn't set") if ENV[name].to_s.empty?
  end
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
end

platform :ios do
  # The listing: metadata, screenshots, categories, copyright, age rating.
  # Never uploads a binary, never submits for review.
  # app_version: the App Store version to fill in, renamed to it if need be
  # (the build's version, e.g. 0.1.202610161805); default: the version
  # App Store Connect is preparing.
  lane :metadata do |options|
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      app_version: options[:app_version],
      metadata_path: "ios/metadata",
      screenshots_path: "ios/screenshots",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: options[:app_version].to_s.empty?,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      primary_category: "MUSIC",
      secondary_category: "PRODUCTIVITY",
      copyright: "2026 Julio Machado Faerman",
      app_rating_config_path: "ios/age-rating.json"
    )
  end

  # App Review, run through scripts/store-submit-ios.sh.
  def tunes
    Spaceship::ConnectAPI.client.tunes_request_client
  end

  def review_submissions(app, states)
    tunes.get("v1/reviewSubmissions", {
      "filter[app]" => app.id, "filter[platform]" => "IOS", "filter[state]" => states.join(",")
    }).body["data"]
  end

  # Takes back the submission waiting for review (not one being reviewed:
  # App Store Connect refuses that), so its version can change again.
  lane :withdraw do
    asc_api_key # also authorizes Spaceship::ConnectAPI
    app = Spaceship::ConnectAPI::App.find(APP_ID) or UI.user_error!("No app #{APP_ID}")
    waiting = review_submissions(app, %w[WAITING_FOR_REVIEW READY_FOR_REVIEW])
    UI.user_error!("Nothing waiting for review") if waiting.empty?
    waiting.each do |sub|
      body = { data: { type: "reviewSubmissions", id: sub["id"], attributes: { canceled: true } } }
      state = tunes.patch("v1/reviewSubmissions/#{sub['id']}", body).body["data"]["attributes"]["state"]
      UI.message("Submission #{sub['id']}: #{state}")
    end
  end

  # Submits the App Store version app_version for review with the processed
  # build (by its build number), released by hand once approved. After a
  # rejection the submission is left with unresolved issues: it's the one
  # submitted again, with the new build.
  lane :submit do |options|
    version_string = options[:app_version].to_s
    build_number = options[:build].to_s
    UI.user_error!("app_version:<version> and build:<build number> are needed") if version_string.empty? || build_number.empty?
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_ID) or UI.user_error!("No app #{APP_ID}")
    unless review_submissions(app, %w[WAITING_FOR_REVIEW IN_REVIEW]).empty?
      UI.user_error!("A submission is already in review; withdraw it first")
    end
    version = app.get_app_store_versions(filter: { versionString: version_string, platform: "IOS" }).first
    UI.user_error!("No App Store version #{version_string} (rename it with the metadata lane)") unless version
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: build_number).first
    UI.user_error!("No build #{build_number}") unless build
    UI.user_error!("Build #{build_number} is #{build.processing_state}") unless build.processed?
    version.select_build(build_id: build.id)
    UI.message("Version #{version_string}: build #{build_number}")

    # A rejected submission, or one being put together (canceled, or left
    # over), is reused.
    sub = review_submissions(app, %w[UNRESOLVED_ISSUES]).first
    sub ||= review_submissions(app, %w[READY_FOR_REVIEW]).first
    sub ||= tunes.post("v1/reviewSubmissions", { data: { type: "reviewSubmissions",
      attributes: { platform: "IOS" },
      relationships: { app: { data: { type: "apps", id: app.id } } } } }).body["data"]
    items = tunes.get("v1/reviewSubmissions/#{sub['id']}/items").body["data"]
    # A rejected item is marked resolved (the fixes are in the new build and
    # listing), as App Store Connect's "Resubmit to App Review" does.
    items.select { |i| i.dig("attributes", "state") == "REJECTED" }.each do |i|
      tunes.patch("v1/reviewSubmissionItems/#{i['id']}", { data: { type: "reviewSubmissionItems",
        id: i["id"], attributes: { resolved: true } } })
      UI.message("Rejected item #{i['id']} marked resolved")
    end
    if items.empty?
      tunes.post("v1/reviewSubmissionItems", { data: { type: "reviewSubmissionItems",
        relationships: { reviewSubmission: { data: { type: "reviewSubmissions", id: sub["id"] } },
                         appStoreVersion: { data: { type: "appStoreVersions", id: version.id } } } } })
    end
    body = { data: { type: "reviewSubmissions", id: sub["id"], attributes: { submitted: true } } }
    state = tunes.patch("v1/reviewSubmissions/#{sub['id']}", body).body["data"]["attributes"]["state"]
    UI.success("Version #{version_string} (build #{build_number}) submitted: #{state}")
  end

  # TestFlight: a build (by its build number) gets the export compliance
  # answer of the app's Info.plist (ITSAppUsesNonExemptEncryption false: no
  # non-exempt encryption) and goes to the internal group "Internal" (made
  # if missing), with testers: the team's App Store Connect users given
  # (testers:a@x,b@y), or else the account holder.
  # No external testers.
  lane :testflight_internal do |options|
    build_number = options[:build].to_s
    UI.user_error!("build:<build number> is needed") if build_number.empty?
    emails = options[:testers].to_s.split(",").map(&:strip).reject(&:empty?)
    asc_api_key # also authorizes Spaceship::ConnectAPI
    app = Spaceship::ConnectAPI::App.find(APP_ID) or UI.user_error!("No app #{APP_ID}")
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: build_number).first
    UI.user_error!("No build #{build_number} yet") unless build
    UI.user_error!("Build #{build_number} is #{build.processing_state}") unless build.processed?

    if build.uses_non_exempt_encryption.nil?
      build.update(attributes: { usesNonExemptEncryption: false })
      UI.message("Build #{build_number}: export compliance set (no non-exempt encryption)")
    else
      UI.message("Build #{build_number}: usesNonExemptEncryption is #{build.uses_non_exempt_encryption}")
    end

    group = app.get_beta_groups(filter: { name: "Internal" }).find { |g| g.name == "Internal" }
    unless group
      # Not app.create_beta_group: it sends public link attributes, which
      # App Store Connect refuses for an internal group (fastlane #29556).
      body = { data: { type: "betaGroups",
                       attributes: { name: "Internal", isInternalGroup: true, hasAccessToAllBuilds: false },
                       relationships: { app: { data: { type: "apps", id: app.id } } } } }
      Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaGroups", body)
      group = app.get_beta_groups(filter: { name: "Internal" }).find { |g| g.name == "Internal" }
      UI.message("Made the internal group Internal")
    end
    UI.user_error!("Group Internal isn't internal") unless group.is_internal_group
    build.add_beta_groups(beta_groups: [group])
    UI.message("Build #{build_number} added to Internal")

    # Default: the team's account holder.
    users = if emails.empty?
              Spaceship::ConnectAPI::User.all.select { |u| Array(u.roles).include?("ACCOUNT_HOLDER") }
            else
              emails.map { |e| Spaceship::ConnectAPI::User.find(email: e).first || UI.user_error!("#{e} isn't a user of the team") }
            end
    UI.user_error!("No testers to add") if users.empty?
    users.each do |user|
      email = user.email.to_s.empty? ? user.username : user.email # the API often gives only the username
      tester = Spaceship::ConnectAPI::BetaTester.find(email: email)
      if tester
        begin
          group.add_beta_testers(beta_tester_ids: [tester.id])
        rescue Spaceship::UnexpectedResponse => e
          # A tester already in the group "cannot be assigned" again.
          raise unless e.message.include?("cannot be assigned")
        end
      else
        Spaceship::ConnectAPI.post_beta_tester_assignment(
          beta_group_ids: [group.id],
          attributes: { email: email, firstName: user.first_name, lastName: user.last_name }
        )
      end
      UI.message("#{email} is in Internal")
    end
  end
end

platform :android do
  def play_json_key
    path = ENV["PLAY_JSON_KEY_PATH"].to_s
    UI.user_error!("PLAY_JSON_KEY_PATH isn't set") if path.empty?
    path
  end

  # The Play listing: title, descriptions, icon, feature graphic, phone
  # screenshots (android/en-US). Never uploads a build.
  lane :metadata do
    upload_to_play_store(
      json_key: play_json_key,
      package_name: APP_ID,
      metadata_path: "android",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true
    )
  end

  # A signed App Bundle (aab:<path>) to a testing track (track:, default
  # internal), with android/en-US/changelogs/default.txt as its notes.
  # status: draft (the default, and all Play takes before the app's first
  # review) or completed (rolled out to the track's testers).
  # Never the production track.
  lane :upload do |options|
    aab = options[:aab].to_s
    UI.user_error!("aab:<path> is needed") if aab.empty?
    track = (options[:track] || "internal").to_s
    UI.user_error!("No production uploads from here") if track == "production"
    upload_to_play_store(
      json_key: play_json_key,
      package_name: APP_ID,
      aab: aab,
      track: track,
      release_status: (options[:status] || "draft").to_s,
      metadata_path: "android",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
