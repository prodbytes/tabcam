# The real values are kept in the private prodbytes/setec-astronomy repo
# (tabcam.nu01/.env); scripts/link-private.sh links them in. Otherwise,
# copy this to .env (gitignored) and fill it in.
#
# Build settings reach the Flutter app with --dart-define, but only the
# names listed in scripts/dart-defines.sh (public values; never secrets).
# The deploy settings below are read by scripts/deploy.sh only.

# iOS: your Apple development team ID (Xcode > Settings > Accounts; a free
# Personal Team works for development installs). Written to the git-ignored
# tabcam_app/ios/Flutter/Private.xcconfig, never committed.
TABCAM_IOS_DEVELOPMENT_TEAM=

# Sign-in and cloud sync (see specs/cloud-sync.md). Public identifiers,
# compiled into the app; all empty, the app has no sign-in and events stay
# on the device.
# Google OAuth clients: the "Web application" client (web, and the server
# client on Android and iOS; the identity pool trusts it) and the "iOS"
# client (bundle ID com.nu01.tabcam). Android's client has no ID here:
# Google matches it by package name (com.nu01.tabcam) and the signing
# key's SHA-1.
TABCAM_GOOGLE_WEB_CLIENT_ID=
TABCAM_GOOGLE_IOS_CLIENT_ID=
# Sign in with Apple on iOS (App Store guideline 4.8), beside Google: 1 to
# offer it. Needs a paid Apple Developer Program team (a free Personal Team
# can't sign the capability) with Sign in with Apple on the App ID
# com.nu01.tabcam, and the identity pool and share API trusting Apple
# (tabcam_infra/README.md). Also adds the entitlement to iOS builds (through
# Private.xcconfig). Empty: no Apple button, no entitlement.
TABCAM_APPLE_SIGN_IN=
# Sign in with email: the tabcam-email-signin stack's UserPoolId and
# ClientId (tabcam_infra/README.md). Empty: no email button.
TABCAM_EMAIL_USER_POOL_ID=
TABCAM_EMAIL_CLIENT_ID=
# The Text view's Fix button (lining the tab up, and Premium's online
# auto-correct through Claude): true to show it. Empty: hidden, as in the
# published builds, while its cost per user is unmeasured (specs/autocorrect.md).
TABCAM_FIX=
# Reading users' folders through CloudFront (tabcam_api/shares/cdn.py):
# the site the Android and iOS apps read them from (the web app reads its
# own), e.g. https://tabcam.nu01.com. Empty: they read S3 directly.
TABCAM_CDN_URL=
# The share API's CloudFront key group (deploy-share-api.sh prints it), for
# scripts/deploy.sh: the sites then serve users' folders to signed URLs.
TABCAM_CDN_KEY_GROUP_ID=
# The local "Web application" client, which the dev web server
# (scripts/flutter-web.sh) uses in place of TABCAM_GOOGLE_WEB_CLIENT_ID.
# Its authorized JavaScript origins are the local URLs:
# https://local.tabcam.nu01.com:2443 and http://localhost:2012. Empty: the
# dev server uses TABCAM_GOOGLE_WEB_CLIENT_ID.
TABCAM_GOOGLE_LOCAL_WEB_CLIENT_ID=
# The stacks' outputs (tabcam_infra/README.md): tabcam-identity's
# IdentityPoolId and tabcam-user-data's UserDataBucketName.
AWS_REGION=us-east-1
TABCAM_COGNITO_IDENTITY_POOL_ID=
# The local pool (tabcam-identity-local's IdentityPoolId), which trusts
# TABCAM_GOOGLE_LOCAL_WEB_CLIENT_ID; the dev web server uses it in place
# of TABCAM_COGNITO_IDENTITY_POOL_ID along with the local client.
TABCAM_COGNITO_LOCAL_IDENTITY_POOL_ID=
TABCAM_USER_DATA_BUCKET=
# Sharing captures by email: tabcam-share-api's ApiUrl
# (scripts/deploy-share-api.sh prints it). Empty: no sharing.
TABCAM_SHARE_API_URL=
# TabCam Premium's cloud OCR: tabcam-ocr's ApiUrl
# (tabcam_locr/scripts/deploy.sh prints it). Empty: no Premium.
TABCAM_OCR_URL=
# Maintenance mode's status file (specs/maintenance-mode.md). Empty: the
# web app reads its own site's /status.json, other builds their stage's.
TABCAM_STATUS_URL=

# Production deploys (scripts/deploy.sh): the site's Route 53 zone.
TABCAM_HOSTED_ZONE_ID=
