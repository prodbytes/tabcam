# The real values are kept in the private prodbytes/setec-astronomy repo
# (tabscan.nu01/.env); scripts/link-private.sh links them in. Otherwise,
# copy this to .env (gitignored) and fill it in.
#
# Build settings reach the Flutter app with --dart-define, but only the
# names listed in scripts/dart-defines.sh (public values; never secrets).
# The deploy settings below are read by scripts/deploy.sh only.

# iOS: your Apple development team ID (Xcode > Settings > Accounts; a free
# Personal Team works for development installs). Written to the git-ignored
# tabscan_app/ios/Flutter/Private.xcconfig, never committed.
TABSCANNER_IOS_DEVELOPMENT_TEAM=

# Sign-in and cloud sync (see specs/cloud-sync.md). Public identifiers,
# compiled into the app; all empty, the app has no sign-in and events stay
# on the device.
# Google OAuth clients: the "Web application" client (web, and the server
# client on Android and iOS; the identity pool trusts it) and the "iOS"
# client (bundle ID com.nu01.tabscan). Android's client has no ID here:
# Google matches it by package name (com.nu01.tabscan) and the signing
# key's SHA-1.
TABSCANNER_GOOGLE_WEB_CLIENT_ID=
TABSCANNER_GOOGLE_IOS_CLIENT_ID=
# The local "Web application" client, which the dev web server
# (scripts/flutter-web.sh) uses in place of TABSCANNER_GOOGLE_WEB_CLIENT_ID.
# Its authorized JavaScript origins are the local URLs:
# https://local.tabscan.nu01.com:2443 and http://localhost:2012. Empty: the
# dev server uses TABSCANNER_GOOGLE_WEB_CLIENT_ID.
TABSCANNER_GOOGLE_LOCAL_WEB_CLIENT_ID=
# The stacks' outputs (tabscan_infra/README.md): tabscan-identity's
# IdentityPoolId and tabscan-user-data's UserDataBucketName.
AWS_REGION=us-east-1
TABSCANNER_COGNITO_IDENTITY_POOL_ID=
TABSCANNER_USER_DATA_BUCKET=
# Sharing captures by email: tabscan-share-api's ApiUrl
# (scripts/deploy-share-api.sh prints it). Empty: no sharing.
TABSCANNER_SHARE_API_URL=
# TabScan Premium's cloud OCR: tabscan-ocr's ApiUrl
# (tabscan_locr/scripts/deploy.sh prints it). Empty: no Premium.
TABSCANNER_OCR_URL=
# Maintenance mode's status file (specs/maintenance-mode.md). Empty: the
# web app reads its own site's /status.json, other builds their stage's.
TABSCANNER_STATUS_URL=

# Production deploys (scripts/deploy.sh): the site's Route 53 zone.
TABSCANNER_HOSTED_ZONE_ID=
# Deploys: who is emailed when the site's health check fails or recovers,
# comma-separated.
TABSCANNER_HEALTH_EMAILS=
