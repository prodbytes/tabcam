{
  "name": "TabScan",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  // Flutter's web builds want more than the smallest machine.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "forwardPorts": [2012, 2013],
  "portsAttributes": {
    "2012": { "label": "Flutter web" },
    "2013": { "label": "Index (redirect to /app/)" }
  },
  "postCreateCommand": "bash -lc 'bash .devcontainer/post-create.sh'"
}
