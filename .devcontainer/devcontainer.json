{
  "name": "TabCam",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  // Flutter's web builds want more than the smallest machine.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  // Floci runs in docker-in-docker, where host-gateway is the bridge
  // address, not loopback: the dev servers must listen on every interface
  // for its CloudFront to reach them (only the container sees them).
  "containerEnv": {
    "TABCAM_BIND_HOST": "0.0.0.0"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "forwardPorts": [2012, 2013, 2014, 2443],
  "portsAttributes": {
    "2012": { "label": "Flutter web" },
    "2013": { "label": "Index (redirect to /app/)" },
    "2014": { "label": "Floci (CloudFront)" },
    "2443": { "label": "Floci HTTPS" }
  },
  "postCreateCommand": "bash -lc 'bash .devcontainer/post-create.sh'"
}
